# Optional: override the default known Studionet campaign instance.
# An address in the ?campaign= URL parameter takes precedence.
VITE_CAMPAIGN_CONTRACT_ADDRESS=0x90DD260FEB475418B96C8316D8964341D8375552

# Optional: actual review transaction hash for an existing contract, for a verified
# consensus timeline after reload. Fresh review hashes are persisted by this browser.
VITE_CAMPAIGN_REVIEW_TX=0xf2fa2d386c8fd8b51f6baf9583803a79d6334e4409a5a6cebb816f191ce22be8

# Optional Studio transaction explorer base; defaults to the official Studio Explorer.
VITE_STUDIONET_EXPLORER_URL=https://explorer-studio.genlayer.com
